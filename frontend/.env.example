NEXT_PUBLIC_API_URL=http://localhost:3001

# LLM provider: "webllm" (production, on-device via WebGPU) or "ollama" (dev)
NEXT_PUBLIC_LLM_PROVIDER=ollama

# Ollama settings (used when NEXT_PUBLIC_LLM_PROVIDER=ollama)
NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434
NEXT_PUBLIC_OLLAMA_MODEL=phi3:mini

# WebLLM model override (used when NEXT_PUBLIC_LLM_PROVIDER=webllm)
# NEXT_PUBLIC_WEBLLM_MODEL=Phi-3.5-mini-instruct-q4f16_1-MLC
