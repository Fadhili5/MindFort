{
  "name": "mindvault-lightway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build:native": "node-gyp rebuild --directory bindings/node",
    "build": "npm run build:native && tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "^5.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "node-addon-api": "^8.3.1",
    "node-gyp": "^11.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
